{
  "name": "pay",
  "version": "0.8.4",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "node --experimental-test-module-mocks --import tsx --test $(find src -name '*.test.ts' | sort)",
    "test:watch": "node --experimental-test-module-mocks --import tsx --test --watch $(find src -name '*.test.ts' | sort)",
    "test:integration": "tsx tests/integration/smoke.ts",
    "seed": "tsx prisma/seed.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "next": "^16.4.6",
    "prisma": "^5.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.5.0"
  }
}
