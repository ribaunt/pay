# Copy to .env next to compose.yml and fill in the values below.
PAY_VERSION=v0.8.4
MONERO_NETWORK=mainnet
MONERO_DAEMON_ADDRESS=your-node.example.com:18081
TRUST_PROXY=0

# Watch-only wallet imported on first boot. Spend keys are never used.
MONERO_WALLET_ADDRESS=
MONERO_WALLET_VIEW_KEY=
MONERO_WALLET_RESTORE_HEIGHT=0
MONERO_WALLET_DESCRIPTION=
