# Copy to .env next to compose.yml and fill in the values below.
PAY_VERSION=v0.8.4
MONERO_NETWORK=mainnet
MONERO_DAEMON_ADDRESS=your-node.example.com:18081
TRUST_PROXY=0

# Settlement and webhook dispatch interval (seconds). Lower = faster payment
# detection but more wallet RPC and database work. Default: 30.
CRON_INTERVAL_SECONDS=30

# Data retention in days (0 disables purging that category).
RETENTION_PAYMENT_REQUESTS_DAYS=365
RETENTION_WEBHOOK_DELIVERIES_DAYS=30
RETENTION_RATE_LIMIT_BUCKETS_DAYS=1

# Watch-only wallet imported on first boot. Spend keys are never used.
MONERO_WALLET_ADDRESS=
MONERO_WALLET_VIEW_KEY=
MONERO_WALLET_RESTORE_HEIGHT=0
MONERO_WALLET_DESCRIPTION=
