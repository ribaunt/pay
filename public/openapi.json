{
  "openapi": "3.0.3",
  "info": {
    "title": "Ribaunt Pay API",
    "version": "0.9.0",
    "description": "API-first, watch-only Monero payment server. All amounts use XMR/atomic pairs and every timestamp is an ISO string or null. See pay.ribaunt.com for full field documentation."
  },
  "servers": [{ "url": "http://localhost:3000" }],
  "components": {
    "securitySchemes": {
      "ApiKey": { "type": "apiKey", "in": "header", "name": "x-api-key" },
      "CronSecret": { "type": "apiKey", "in": "header", "name": "x-cron-secret" },
      "StatusToken": { "type": "apiKey", "in": "header", "name": "x-status-token" },
      "SessionCookie": { "type": "apiKey", "in": "cookie", "name": "pay_session" }
    },
    "schemas": {
      "PaymentLink": {
        "type": "object",
        "required": ["id", "status", "amountXmr", "amountAtomic", "txHash", "confirmations"],
        "properties": {
          "id": { "type": "string" },
          "storeId": { "type": "string", "nullable": true },
          "status": { "type": "string" },
          "address": { "type": "string", "nullable": true },
          "uri": { "type": "string", "nullable": true },
          "label": { "type": "string", "nullable": true },
          "amountXmr": { "type": "string" },
          "amountAtomic": { "type": "string" },
          "receivedXmr": { "type": "string", "nullable": true },
          "receivedAtomic": { "type": "string", "nullable": true },
          "coveredXmr": { "type": "string" },
          "coveredAtomic": { "type": "string" },
          "unlockedXmr": { "type": "string" },
          "unlockedAtomic": { "type": "string" },
          "complete": { "type": "boolean" },
          "zeroConf": { "type": "boolean" },
          "fiatAmount": { "type": "string", "nullable": true },
          "fiatCurrency": { "type": "string", "nullable": true },
          "rateUsd": { "type": "string", "nullable": true },
          "fxRate": { "type": "string", "nullable": true },
          "rateSources": { "type": "string", "nullable": true },
          "rateFetchedAt": { "type": "string", "nullable": true },
          "rateStale": { "type": "boolean" },
          "rateDegraded": { "type": "boolean" },
          "requiredConfirmations": { "type": "integer" },
          "confirmations": { "type": "integer" },
          "confirmationsRemaining": { "type": "integer" },
          "txHash": { "type": "string", "nullable": true },
          "createdAt": { "type": "string", "nullable": true },
          "expiresAt": { "type": "string", "nullable": true },
          "paidAt": { "type": "string", "nullable": true },
          "cancelledAt": { "type": "string", "nullable": true },
          "lateDetectedAt": { "type": "string", "nullable": true }
        }
      },
      "CreateLinkInput": {
        "type": "object",
        "properties": {
          "amountXmr": { "type": "string" },
          "fiatAmount": { "type": "string" },
          "fiatCurrency": { "type": "string" },
          "timeoutSeconds": { "type": "integer" },
          "requiredConfirmations": { "type": "integer", "minimum": 1, "maximum": 100 },
          "zeroConf": { "type": "boolean" },
          "label": { "type": "string" },
          "description": { "type": "string" }
        }
      },
      "WebhookPayload": {
        "type": "object",
        "properties": {
          "event": { "type": "string" },
          "createdAt": { "type": "string" },
          "data": { "$ref": "#/components/schemas/PaymentLink" }
        }
      },
      "Attestation": {
        "type": "object",
        "properties": {
          "kind": { "type": "string" },
          "version": { "type": "integer" },
          "from": { "type": "string" },
          "to": { "type": "string" },
          "network": { "type": "string" },
          "confirmedCount": { "type": "integer" },
          "totalXmr": { "type": "string" },
          "totalAtomic": { "type": "string" },
          "fiatTotal": { "type": "string", "nullable": true },
          "fiatCurrency": { "type": "string", "nullable": true },
          "generatedAt": { "type": "string" },
          "signature": { "type": "string" }
        }
      }
    }
  },
  "paths": {
    "/api/health": {
      "get": { "summary": "Service health", "responses": { "200": { "description": "Health" } } }
    },
    "/api/sync": {
      "get": { "summary": "Wallet sync progress with percentage and ETA", "responses": { "200": { "description": "Sync progress" } } }
    },
    "/api/auth/csrf": {
      "get": { "summary": "Issue a CSRF cookie and token for browser sessions", "responses": { "200": { "description": "Token" } } }
    },
    "/api/auth/login": {
      "post": {
        "summary": "Sign in with env credentials",
        "requestBody": { "content": { "application/json": { "schema": { "type": "object", "required": ["email", "password"], "properties": { "email": { "type": "string" }, "password": { "type": "string" } } } } } },
        "responses": { "200": { "description": "Session cookie issued" } }
      }
    },
    "/api/auth/logout": {
      "post": { "summary": "Revoke all sessions", "security": [{ "SessionCookie": [] }], "responses": { "200": { "description": "Logged out" } } }
    },
    "/api/auth/me": {
      "get": { "summary": "Current session user", "security": [{ "SessionCookie": [] }], "responses": { "200": { "description": "User" } } }
    },
    "/api/payment-links": {
      "get": {
        "summary": "List payment links",
        "security": [{ "ApiKey": [] }, { "SessionCookie": [] }],
        "parameters": [{ "name": "status", "in": "query", "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Links" } }
      },
      "post": {
        "summary": "Create a payment link",
        "security": [{ "ApiKey": [] }],
        "parameters": [{ "name": "Idempotency-Key", "in": "header", "schema": { "type": "string" } }],
        "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateLinkInput" } } } },
        "responses": { "201": { "description": "Created link" } }
      }
    },
    "/api/payment-links/{id}/status": {
      "get": {
        "summary": "Read link status",
        "security": [{ "StatusToken": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Status", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PaymentLink" } } } } }
      }
    },
    "/api/payment-links/{id}/cancel": {
      "post": {
        "summary": "Cancel a waiting link",
        "security": [{ "ApiKey": [] }, { "SessionCookie": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Cancelled link" }, "404": { "description": "Unknown or other store's link" } }
      }
    },
    "/api/payment-links/{id}/renew": {
      "post": {
        "summary": "Renew an expired link once",
        "security": [{ "ApiKey": [] }, { "SessionCookie": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "201": { "description": "Renewed link" }, "404": { "description": "Unknown or other store's link" } }
      }
    },
    "/api/prices/currencies": {
      "get": { "summary": "Supported fiat currencies", "responses": { "200": { "description": "Currencies" } } }
    },
    "/api/prices/quote": {
      "get": {
        "summary": "Fiat to XMR quote",
        "parameters": [
          { "name": "fiatAmount", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "fiatCurrency", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Quote" } }
      }
    },
    "/api/public/payment-proofs/verify": {
      "post": {
        "summary": "Verify a payment proof without an account",
        "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "txHash": { "type": "string" }, "address": { "type": "string" }, "message": { "type": "string" } } } } } },
        "responses": { "200": { "description": "Verification result" } }
      }
    },
    "/api/webhooks": {
      "get": {
        "summary": "List webhook endpoints",
        "security": [{ "ApiKey": [] }, { "SessionCookie": [] }],
        "responses": { "200": { "description": "Endpoints" } }
      },
      "post": {
        "summary": "Register a webhook endpoint",
        "security": [{ "ApiKey": [] }, { "SessionCookie": [] }],
        "requestBody": { "content": { "application/json": { "schema": { "type": "object", "required": ["url"], "properties": { "url": { "type": "string" }, "events": { "type": "string", "description": "Comma-separated event names or *" } } } } } },
        "responses": { "201": { "description": "Endpoint and one-time secret" } }
      }
    },
    "/api/cron/payment-links": {
      "post": {
        "summary": "Run a settlement pass",
        "security": [{ "CronSecret": [] }],
        "responses": { "200": { "description": "Processed count, or skipped when a pass is already running" } }
      }
    },
    "/api/cron/webhooks": {
      "post": { "summary": "Deliver queued webhook events", "security": [{ "CronSecret": [] }], "responses": { "200": { "description": "Delivery counts" } } }
    },
    "/api/cron/retention": {
      "post": { "summary": "Purge expired records by retention category", "security": [{ "CronSecret": [] }], "responses": { "200": { "description": "Deleted counts" } } }
    },
    "/api/metrics": {
      "get": { "summary": "Prometheus metrics", "security": [{ "ApiKey": [] }], "responses": { "200": { "description": "Metrics", "content": { "text/plain": {} } } } }
    },
    "/api/events": {
      "get": {
        "summary": "Server-sent payment events",
        "security": [{ "StatusToken": [] }, { "ApiKey": [] }, { "SessionCookie": [] }],
        "parameters": [
          { "name": "linkId", "in": "query", "schema": { "type": "string" } },
          { "name": "x-status-token", "in": "header", "schema": { "type": "string" }, "description": "Bearer token for a single link; never place it in the URL" }
        ],
        "responses": { "200": { "description": "Event stream", "content": { "text/event-stream": {} } }, "429": { "description": "Too many stream starts; see Retry-After" } }
      }
    },
    "/api/wallet/audit": {
      "get": {
        "summary": "View-key-only accounting export",
        "security": [{ "ApiKey": [] }, { "SessionCookie": [] }],
        "parameters": [{ "name": "format", "in": "query", "schema": { "type": "string", "enum": ["json", "csv"] } }],
        "responses": { "200": { "description": "Audit export" } }
      }
    },
    "/api/wallet/setup": {
      "post": { "summary": "Import a watch-only wallet", "security": [{ "SessionCookie": [] }], "responses": { "200": { "description": "Wallet" } } }
    },
    "/api/wallet": {
      "get": { "summary": "Wallet information", "security": [{ "SessionCookie": [] }], "responses": { "200": { "description": "Wallet" } } }
    },
    "/api/wallet/balance": {
      "get": { "summary": "Wallet balances", "security": [{ "SessionCookie": [] }], "responses": { "200": { "description": "Balances" } } }
    },
    "/api/wallet/address": {
      "get": { "summary": "Primary wallet address", "security": [{ "SessionCookie": [] }], "responses": { "200": { "description": "Address" } } }
    },
    "/api/wallet/transfers": {
      "get": { "summary": "Transfer history", "security": [{ "SessionCookie": [] }], "responses": { "200": { "description": "Transfers" } } }
    },
    "/api/wallet/subaddresses": {
      "get": { "summary": "List subaddresses", "security": [{ "SessionCookie": [] }], "responses": { "200": { "description": "Subaddresses" } } },
      "post": { "summary": "Create a fresh subaddress", "security": [{ "SessionCookie": [] }], "responses": { "201": { "description": "Subaddress" } } }
    },
    "/api/wallet/payment-requests": {
      "get": { "summary": "List stored payment requests", "security": [{ "SessionCookie": [] }], "responses": { "200": { "description": "Requests" } } },
      "post": { "summary": "Create a payment URI", "security": [{ "SessionCookie": [] }], "responses": { "201": { "description": "Request" } } }
    },
    "/api/wallet/payment-proofs": {
      "get": { "summary": "List payment proofs", "security": [{ "SessionCookie": [] }], "responses": { "200": { "description": "Proofs" } } },
      "post": { "summary": "Generate a payment proof", "security": [{ "SessionCookie": [] }], "responses": { "201": { "description": "Proof" } } }
    },
    "/api/wallet/close": {
      "post": { "summary": "Close the loaded wallet", "security": [{ "SessionCookie": [] }], "responses": { "200": { "description": "Closed" } } }
    },
    "/api/admin/api-keys": {
      "get": { "summary": "List API keys", "security": [{ "SessionCookie": [] }], "responses": { "200": { "description": "Keys" } } },
      "post": { "summary": "Create an API key", "security": [{ "SessionCookie": [] }], "responses": { "201": { "description": "Key and one-time secret" } } }
    },
    "/api/admin/api-keys/{id}/revoke": {
      "post": { "summary": "Revoke an API key", "security": [{ "SessionCookie": [] }], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Revoked" } } }
    },
    "/api/admin/stores": {
      "get": { "summary": "List unlinkable stores", "security": [{ "SessionCookie": [] }], "responses": { "200": { "description": "Stores" } } },
      "post": { "summary": "Create a store with its own Monero account", "security": [{ "SessionCookie": [] }], "responses": { "201": { "description": "Store" } } }
    },
    "/api/admin/attestations": {
      "get": {
        "summary": "Signed aggregate revenue attestation",
        "security": [{ "SessionCookie": [] }],
        "parameters": [
          { "name": "from", "in": "query", "schema": { "type": "string", "format": "date-time" } },
          { "name": "to", "in": "query", "schema": { "type": "string", "format": "date-time" } },
          { "name": "storeId", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Attestation", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Attestation" } } } } }
      }
    }
  }
}
