# Postgres
POSTGRES_USER=pay
POSTGRES_PASSWORD=replace-with-a-password-at-least-16-characters
POSTGRES_DB=pay
POSTGRES_PORT=5432

# App
# prod      = hardened Next server + internal wallet RPC
# dev       = isolated DB :5433, hot reload :3001, RPC debug :18083
# tor       = add the optional onion service (combine with prod)
# tor-only  = onion service only, no clearnet ports
# i2p-only  = I2P HTTP tunnel only, no clearnet ports
COMPOSE_PROFILES=prod
DATABASE_URL=postgresql://pay:pay@db:5432/pay?schema=public
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=production
# No telemetry, ever
NEXT_TELEMETRY_DISABLED=1
DO_NOT_TRACK=1

# === Single-user credentials ===
# The only accepted sign-in. No sign-ups or anonymous sessions.
SINGLE_USER_EMAIL=admin@example.com
SINGLE_USER_PASSWORD=replace-with-a-password-at-least-12-characters

# === Secrets: replace every value below before deploying ===
# Session signing key (>= 32 chars): openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-session-secret
# AES-256-GCM key, 64 hex chars: openssl rand -hex 32
WALLET_ENCRYPTION_KEY=replace-with-64-hex-characters-for-aes-256-gcm-encryption-key

# Monero wallet RPC
# mainnet or stagenet. Modes are mutually exclusive: mainnet addresses are
# rejected while stagenet is active, and vice versa.
MONERO_NETWORK=mainnet
# No monerod is bundled. Leave empty to use the default node for the selected
# network, or point this at your own node for privacy.
MONERO_DAEMON_ADDRESS=
# full-scan keeps view-key scanning local. Light-wallet mode is not supported.
MONERO_DAEMON_MODE=full-scan
# Optional SOCKS proxy for daemon connections, e.g. 127.0.0.1:9050 via Tor.
MONERO_DAEMON_PROXY=
# Optional comma-separated fallback daemons used by the health check.
MONERO_DAEMON_FALLBACKS=
MONERO_RPC_USER=monero
MONERO_RPC_PASSWORD=replace-with-a-strong-rpc-password
# Password used to encrypt each watch-only wallet file in wallet_data
MONERO_WALLET_PASSWORD=replace-with-a-wallet-password-at-least-16-characters

# Set to 1 only when a trusted reverse proxy overwrites X-Forwarded-For.
TRUST_PROXY=0
# Required for encrypted backups.
BACKUP_PASSPHRASE=replace-with-a-long-backup-passphrase

# Payment links API (server-to-server)
PAYMENT_API_KEY=replace-with-a-long-random-api-key
CRON_SECRET=replace-with-a-long-random-cron-secret
PAYMENT_DEFAULT_TIMEOUT_SECONDS=1800
PAYMENT_MIN_TIMEOUT_SECONDS=60
PAYMENT_MAX_TIMEOUT_SECONDS=86400
PAYMENT_REQUIRED_CONFIRMATIONS=10
PRICE_CACHE_TTL_SECONDS=60
PRICE_MAX_STALENESS_SECONDS=300
PRICE_OUTLIER_THRESHOLD_BPS=500
HEALTH_MAX_SYNC_LAG_BLOCKS=10
